# ─────────────────────────────────────────────────
#  CodeAura v3.1.0 — Environment Configuration
# ─────────────────────────────────────────────────

# REQUIRED for AI features (explanations, query expansion, chat, re-ranking)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=gsk_...

# OPTIONAL — HuggingFace API for real embeddings (fallback to local if not set)
# Get your free key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# OPTIONAL — Override the default embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OPTIONAL — Override the default LLM model
GROQ_MODEL=llama-3.3-70b-versatile

# OPTIONAL — ChromaDB connection (defaults to localhost:8000, falls back to in-memory)
CHROMA_URL=http://localhost:8000

# OPTIONAL — Indexing performance tuning
FILE_CONCURRENCY=8           # files processed in parallel
HF_BATCH_SIZE=24             # embeddings per API batch call
MAX_FILES=5000               # max files per index run
MAX_FILE_SIZE_MB=1.5         # skip files larger than this

# OPTIONAL — Chunking strategy
PARENT_CHUNK_SIZE=1200       # parent block size (returned as context)
CHILD_CHUNK_SIZE=350         # child chunk size (used for matching)
CHUNK_OVERLAP=60             # overlap between consecutive chunks
